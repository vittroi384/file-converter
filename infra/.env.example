# infra/.env 로 복사해서 채운다(.env는 저장소에 올리지 않는다)
# 비밀번호 해시: node tools/hash-password.ts '10자 이상 비밀번호'
# 해시에 '$'가 들어 있어 꼭 작은따옴표로 감싼다(안 그러면 compose가 변수로 읽어 해시가 깨지고 로그인이 안 된다)
ADMIN_PASSWORD_HASH='scrypt$...$...'
# 아무 긴 무작위 문자열: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 로컬(http)에서 시험할 땐 false, 운영(https)에선 true
SECURE_COOKIE=true
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# 빌드 번호는 deploy.sh가 자동으로 정한다(관리자 화면 '배포')
# BUILD_ID=
# Grafana(127.0.0.1:3002, SSH 터널로만 연다) 관리자 admin의 비밀번호. 비워 두면 compose가 시작을 거부한다
# node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
GRAFANA_ADMIN_PASSWORD=
# api 앞에 있는 프록시 수(앞단 리버스 프록시 + nginx = 2, nginx만 = 1). 틀리면 요청 제한이 위조로 뚫리거나 모두 한 IP로 묶인다
TRUST_PROXY_HOPS=2
