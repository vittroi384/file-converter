        "type": "dashboard"
      },
      {
        "name": "배포",
        "datasource": {
          "type": "prometheus",
          "uid": "vm"
        },
        "enable": true,
        "iconColor": "rgba(137, 135, 129, 0.8)",
        "expr": "max by (component, version) (max_over_time(fc_build_info[$__interval])) unless max by (component, version) (max_over_time(fc_build_info[1h] offset $__interval))",
        "titleFormat": "배포 {{version}}",
        "textFormat": "{{component}}",
        "tagKeys": "component",
        "useValueForTime": false,
        "step": ""
      }
    ]
